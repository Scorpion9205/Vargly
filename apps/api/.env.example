# ==============================================================================
# Vargly Backend Environment Configuration
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
# Run queue workers inside the API too. Defaults to true only when NODE_ENV=development (single
# `pnpm dev`); in staging/production run the worker process separately (`pnpm start:worker`).
# RUN_WORKERS_IN_API=false
CORS_ORIGIN=http://localhost:3000
# Proxy hops in front of the API (1 behind a single ingress/load balancer). Leave false when exposed directly;
# otherwise clients can spoof X-Forwarded-For to evade rate limits and login lockout.
TRUST_PROXY=false
# Who is emailed when a payment needs review or an event has given up (needs SMTP_* below; unset: only the /app/admin console and logs show it)
OPS_ALERT_EMAIL=
# Bearer token Prometheus must send to read /metrics (unset: open in development, disabled in production)
METRICS_TOKEN=
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
# Tenant isolation relies on row-level security, which PostgreSQL skips for superusers. The API
# must connect as the ordinary application role (infra/docker/postgres/create-app-role.sql);
# production refuses to start otherwise. Run migrations separately with the schema owner:
#   DATABASE_URL=<owner url> pnpm prisma:migrate:deploy
# With the local docker-compose database: vargly_app / APP_DB_PASSWORD from infra/docker/compose.env
# (created by `pnpm docker:env`). Migrations use vargly_owner / POSTGRES_PASSWORD.
DATABASE_URL=postgresql://vargly_app:CHANGE_ME@localhost:5433/vargly_db?schema=public

# Integration tests (optional locally; always run in CI): owner for fixtures, app role for the API under test
# TEST_DATABASE_OWNER_URL=postgresql://<owner>:<password>@localhost:5432/vargly_test
# TEST_DATABASE_URL=postgresql://vargly_app:<password>@localhost:5432/vargly_test

# Redis (Session cache, BullMQ queues, sliding-window rate limiters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (Argon2id + RS256 JWT)
JWT_ACCESS_SECRET=vargly_dev_access_super_secret_key_change_in_production_32char
JWT_REFRESH_SECRET=vargly_dev_refresh_super_secret_key_change_in_production_32char
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# RS256 PEM keys (newlines escaped as \n). REQUIRED in production; the API refuses to start without them.
# In development they may be left empty: a local keypair is generated into .keys/ (git-ignored).
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key && openssl rsa -in jwt.key -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
DATABASE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ==============================================================================
# 1. Meta WhatsApp Cloud API
# ==============================================================================
# Obtain from Meta Developers Portal (https://developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vargly_webhook_secret_token
WHATSAPP_API_VERSION=v19.0
# Most automatic WhatsApp messages one institute may send per day
WHATSAPP_DAILY_LIMIT_PER_COACHING=200

# ==============================================================================
# 2. Email / SMTP Configuration
# ==============================================================================
# Use Gmail App Password, AWS SES SMTP, SendGrid, or Mailtrap
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Vargly Alerts <notifications@vargly.in>"

# ==============================================================================
# 3. AI Providers (OpenAI / Claude / Google Gemini)
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model names (providers retire models on their own schedule; change here, not in code)
AI_MODEL_CLAUDE=claude-sonnet-5
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_GEMINI=gemini-2.5-flash
# Embeddings for the WhatsApp assistant's knowledge base (1536 dimensions). Changing the model
# requires re-syncing knowledge bases: search only compares vectors from the current model.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ==============================================================================
# 4. Object Storage (S3 / Cloudflare R2 / MinIO)
# ==============================================================================
# For local MinIO or AWS S3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=vargly-attachments
S3_PUBLIC_URL_PREFIX=

# ==============================================================================
# 5. Payment Gateway (Razorpay / UPI)
# ==============================================================================
# Obtain from Razorpay Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Price of one AI credit top-up, in paise (100 = Rs 1 per credit). Plan prices come from the plans table.
AI_CREDIT_PRICE_PAISE=100
