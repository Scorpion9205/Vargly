{
  "name": "@vargly/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -b",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/workers/worker-runner.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/workers/worker-runner.js",
    "prisma:generate": "prisma generate --schema=src/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=src/database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/database/prisma/schema.prisma",
    "db:seed:rbac": "tsx src/database/prisma/init-rbac.ts",
    "kb:reindex": "node dist/scripts/reindex-knowledge.js",
    "admin:create": "node dist/scripts/create-super-admin.js",
    "admin:create:dev": "tsx src/scripts/create-super-admin.ts",
    "kb:reindex:dev": "tsx src/scripts/reindex-knowledge.ts",
    "test": "vitest run",
    "test:unit": "vitest run src/test/unit",
    "test:integration": "vitest run src/test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@vargly/types": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.14.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vargly/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
