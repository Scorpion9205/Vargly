model NotificationHistory {
  id              String              @id @default(uuid()) @db.Uuid
  coachingId      String              @map("coaching_id") @db.Uuid
  channel         NotificationChannel
  recipient       String              @db.VarChar(255) // Phone or Email
  recipientType   String              @map("recipient_type") @db.VarChar(50) // PARENT, STUDENT, TEACHER
  templateName    String?             @map("template_name") @db.VarChar(100)
  templateVariables Json?             @map("template_variables") // Kept so a retry sends the same message
  content         String              @db.Text
  status          NotificationStatus  @default(QUEUED)
  providerMessageId String?           @map("provider_message_id") @db.VarChar(255)
  errorMessage    String?             @map("error_message") @db.Text
  idempotencyKey  String              @unique @map("idempotency_key") @db.VarChar(255)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz()
  deliveredAt     DateTime?           @map("delivered_at") @db.Timestamptz()
  readAt          DateTime?           @map("read_at") @db.Timestamptz()
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([coachingId, channel, status])
  @@index([coachingId, createdAt])
  @@map("notification_history")
}

/// Phones that replied STOP. Vargly sends from one number for every institute, so opting out
/// is per phone, across institutes, until the person replies START.
model WhatsAppOptOut {
  phone           String              @id @db.VarChar(20) // Last 10 digits
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  @@map("whatsapp_opt_outs")
}

model StudentTimeline {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  eventType       String           @map("event_type") @db.VarChar(100) // ATTENDANCE_MARKED, FEE_PAID, TEST_RESULT
  summary         String           @db.Text
  referenceId     String?          @map("reference_id") @db.Uuid
  metadata        Json?
  occurredAt      DateTime         @default(now()) @map("occurred_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([coachingId, studentId, occurredAt])
  @@map("student_timeline")
}

model RiskScore {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  studentId       String           @unique @map("student_id") @db.Uuid
  score           Decimal          @db.Decimal(5, 2) // 0.00 to 100.00
  level           RiskLevel        @default(LOW)
  attendanceFactor Decimal         @map("attendance_factor") @db.Decimal(5, 2)
