// ==========================================
// 10. AI Knowledge Base & pgvector RAG
// ==========================================

model CoachingKnowledgeBase {
  id             String            @id @default(uuid()) @db.Uuid
  coachingId     String            @map("coaching_id") @db.Uuid
  title          String            @db.VarChar(255)
  type           KnowledgeBaseType @default(FAQ)
  description    String?           @db.Text
  sourceUrl      String?           @map("source_url") @db.Text
  rawContent     String            @map("raw_content") @db.Text
  characterCount Int               @default(0) @map("character_count")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz()

  coaching       Coaching          @relation(fields: [coachingId], references: [id], onDelete: Restrict)
  chunks         CoachingKnowledgeChunk[]

  @@index([coachingId, type, isActive])
  @@map("coaching_knowledge_bases")
}

model CoachingKnowledgeChunk {
  id              String                @id @default(uuid()) @db.Uuid
  coachingId      String                @map("coaching_id") @db.Uuid
  knowledgeBaseId String                @map("knowledge_base_id") @db.Uuid
  chunkIndex      Int                   @map("chunk_index")
  content         String                @db.Text
  tokenCount      Int                   @default(0) @map("token_count")
  metadata        Json?                 @default("{}")
  embedding       Unsupported("vector(1536)")?
  // Which model produced `embedding` (e.g. "openai:text-embedding-3-small"). Vectors from
  // different models are not comparable, so search only uses chunks of the current model.
  embeddingModel  String?               @map("embedding_model") @db.VarChar(100)
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz()

  knowledgeBase   CoachingKnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([coachingId, isActive])
  @@index([coachingId, embeddingModel])
  @@index([knowledgeBaseId, chunkIndex])
  @@map("coaching_knowledge_chunks")
}

// ==========================================
// 11. Money integrity: numbering and Vargly billing
// ==========================================

// Gap-free document counters. scope is a coaching id (fee receipts) or "platform" (Vargly
// invoices); series is e.g. "RCT/2026-27". Incremented inside the transaction that issues the
// document, so a rolled-back payment does not consume a number.
model DocumentSequence {
  scope           String           @db.VarChar(64)
  series          String           @db.VarChar(64)
  lastValue       Int              @default(0) @map("last_value")
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  @@id([scope, series])
  @@map("document_sequences")
}

enum BillingPaymentType {
  PLAN_UPGRADE
  AI_CREDITS

  @@map("billing_payment_type")
}

enum BillingPaymentStatus {
  CREATED
  PAID
  FAILED
  NEEDS_REVIEW // money was taken but the order was not applied (e.g. wrong amount); a person resolves it

  @@map("billing_payment_status")
}

// What a coaching bought from Vargly. Created with the server-computed price when the order is
// placed; the webhook settles it at most once (CREATED -> PAID) and only for the expected amount.
model BillingPayment {
  id               String               @id @default(uuid()) @db.Uuid
  coachingId       String               @map("coaching_id") @db.Uuid
  type             BillingPaymentType
  status           BillingPaymentStatus @default(CREATED)
  planCode         PlanCode?            @map("plan_code")
  billingCycle     String?              @map("billing_cycle") @db.VarChar(20)
  credits          Int?
  amountPaise      Int                  @map("amount_paise")
  currency         String               @default("INR") @db.VarChar(10)
  gatewayOrderId   String               @unique @map("gateway_order_id") @db.VarChar(100)
  gatewayPaymentId String?              @unique @map("gateway_payment_id") @db.VarChar(100)
  invoiceNumber    String?              @unique @map("invoice_number") @db.VarChar(50)
  paidAt           DateTime?            @map("paid_at") @db.Timestamptz()
  reviewNote       String?              @map("review_note") @db.Text
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz()
  reviewedBy       String?              @map("reviewed_by") @db.Uuid
  createdBy        String?              @map("created_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  coaching         Coaching             @relation(fields: [coachingId], references: [id], onDelete: Restrict)

  @@index([coachingId, createdAt])
  @@index([status])
  @@map("billing_payments")
}

// ==========================================
// 12. Durable domain events (outbox)
// ==========================================

enum DomainEventStatus {
  PENDING    // recorded, handlers not yet finished
  DISPATCHED // every handler succeeded
  FAILED     // at least one handler failed; retried with backoff
  DEAD       // gave up after the maximum attempts; needs a person

  @@map("domain_event_status")
}

// Every published domain event is recorded here before its handlers run. Handlers that
// succeed are listed in completedHandlers, so a retry (after a handler error or a process
// crash) re-runs only the ones that have not finished. Internal table: no tenant RLS;
// coachingId can hold platform placeholders such as "platform".
model DomainEventRecord {
  id                String            @id @db.VarChar(64) // the event's eventId
  eventName         String            @map("event_name") @db.VarChar(100)
  coachingId        String            @map("coaching_id") @db.VarChar(64)
  payload           Json
  metadata          Json
  occurredAt        DateTime          @map("occurred_at") @db.Timestamptz()
  status            DomainEventStatus @default(PENDING)
  attempts          Int               @default(0)
  completedHandlers String[]          @default([]) @map("completed_handlers")
  lastError         String?           @map("last_error") @db.Text
  nextAttemptAt     DateTime          @default(now()) @map("next_attempt_at") @db.Timestamptz()
  dispatchedAt      DateTime?         @map("dispatched_at") @db.Timestamptz()
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, nextAttemptAt])
  @@map("domain_events")
}

// ==========================================
// 13. Paper studio: AI-generated or uploaded question papers shared with a batch's parents
// ==========================================

enum PaperSource {
  AI
  UPLOAD

  @@map("paper_source")
}

enum PaperStatus {
  DRAFT
  PUBLISHED

  @@map("paper_status")
}

enum PaperShareKind {
  HOMEWORK // also creates a homework record
  PRACTICE // a worksheet or test paper: only the link is shared

  @@map("paper_share_kind")
}

// A teacher's paper. AI papers keep their questions here (with answers, which never reach
// students); uploaded papers keep the stored file.
model Paper {
  id          String      @id @default(uuid()) @db.Uuid
  coachingId  String      @map("coaching_id") @db.Uuid
  source      PaperSource
  status      PaperStatus @default(DRAFT)
  title       String      @db.VarChar(255)
  subject     String      @db.VarChar(100)
  topic       String?     @db.Text
  language    String      @default("en") @db.VarChar(20)
  questions   Json        @default("[]")
  fileUrl     String?     @map("file_url") @db.Text
  fileKey     String?     @map("file_key") @db.VarChar(500)
  fileName    String?     @map("file_name") @db.VarChar(255)
  createdBy   String?     @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz()

  shares      PaperShare[]

  @@index([coachingId, createdBy, updatedAt])
  @@map("papers")
}

// One paper sent to one batch. The token in the link is the only credential parents need: they
// have no login, so it is long and random, and a share can be switched off by deleting it.
model PaperShare {
  id           String         @id @default(uuid()) @db.Uuid
  coachingId   String         @map("coaching_id") @db.Uuid
  paperId      String         @map("paper_id") @db.Uuid
  batchId      String         @map("batch_id") @db.Uuid
  kind         PaperShareKind
  token        String         @unique @db.VarChar(64)
  homeworkId   String?        @map("homework_id") @db.Uuid
  openCount    Int            @default(0) @map("open_count")
  lastOpenedAt DateTime?      @map("last_opened_at") @db.Timestamptz()
  createdBy    String?        @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  paper        Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  batch        Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([coachingId, paperId])
  @@map("paper_shares")
}
