datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// Enums
// ==========================================

enum RoleType {
  SUPER_ADMIN
  OWNER
  TEACHER

  @@map("role_type")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED

  @@map("attendance_status")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL

  @@map("notification_channel")
}

enum NotificationStatus {
  QUEUED
  SENDING // claimed by a worker; prevents two workers sending the same notification
  SENT
  DELIVERED
  READ
  FAILED

  @@map("notification_status")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  EXPIRED
  CANCELLED

  @@map("subscription_status")
}

enum PlanCode {
  STARTER
  PRO_AI
  ENTERPRISE

  @@map("plan_code")
}

enum FeeInstallmentStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
  OVERDUE

  @@map("fee_installment_status")
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  ONLINE

  @@map("payment_method")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("risk_level")
}

enum AiProviderType {
  OPENAI
  CLAUDE
  GEMINI
  GROQ

  @@map("ai_provider_type")
}

enum KnowledgeBaseType {
  FAQ
  POLICY
  SYLLABUS
  SCHEDULE
  GENERAL_NOTICE

  @@map("knowledge_base_type")
}

// ==========================================
// 1. Platform / Tenant Foundation
// ==========================================

model Coaching {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(255)
  code            String         @unique @db.VarChar(50)
  phone           String         @db.VarChar(30)
  email           String         @db.VarChar(255)
  address         String?        @db.Text
  city            String?        @db.VarChar(100)
  state           String?        @db.VarChar(100)
  logoUrl         String?        @map("logo_url") @db.Text
  timezone        String         @default("Asia/Kolkata") @db.VarChar(50)
  currency        String         @default("INR") @db.VarChar(10)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz()

  // Relations
  users           User[]
  students        Student[]
  parents         Parent[]
  teachers        Teacher[]
  batches         Batch[]
  subscriptions   Subscription[]
  settings        Setting?
  creditWallet    AiCreditWallet?
  notices         Notice[]
  knowledgeBases  CoachingKnowledgeBase[]
  feePlans        FeePlan[]
  salaries        Salary[]
  expenses        Expense[]
  billingPayments BillingPayment[]

  @@map("coachings")
}

// ==========================================
// 2. Identity, RBAC & Security
// ==========================================

model User {
  id              String         @id @default(uuid()) @db.Uuid
  coachingId      String?        @map("coaching_id") @db.Uuid // null for SUPER_ADMIN
  name            String         @db.VarChar(255)
  email           String         @db.VarChar(255)
  phone           String         @db.VarChar(30)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  isActive        Boolean        @default(true) @map("is_active")
  failedLogins    Int            @default(0) @map("failed_logins")
  lockedUntil     DateTime?      @map("locked_until") @db.Timestamptz()
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz()
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz()
  // Access tokens issued before this moment are refused (set when the password changes)
  tokensValidAfter DateTime?     @map("tokens_valid_after") @db.Timestamptz()
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz()
  createdBy       String?        @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid

  coaching        Coaching?      @relation(fields: [coachingId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  refreshTokens   RefreshToken[]
  actionTokens    AuthActionToken[]
  teacherProfile  Teacher?

  @@unique([coachingId, email])
  @@index([coachingId, phone])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String?          @map("coaching_id") @db.Uuid // null for platform defaults
  name            String           @db.VarChar(100)
  code            String           @db.VarChar(50)
  description     String?          @db.Text
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([coachingId, code])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100) // e.g. "attendance:mark"
  module          String           @db.VarChar(50)
  action          String           @db.VarChar(50)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id              String           @id @default(uuid()) @db.Uuid
  roleId          String           @map("role_id") @db.Uuid
  permissionId    String           @map("permission_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  role            Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  roleId          String           @map("role_id") @db.Uuid
  coachingId      String?          @map("coaching_id") @db.Uuid // null for SUPER_ADMIN, who belongs to no coaching
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, coachingId])
  @@index([coachingId, userId])
  @@map("user_roles")
}

model RefreshToken {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  tokenHash       String           @unique @map("token_hash") @db.VarChar(255)
  family          String           @db.VarChar(255) // For rotation reuse detection
  isRevoked       Boolean          @default(false) @map("is_revoked")
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz()
  userAgent       String?          @map("user_agent") @db.Text
  ipAddress       String?          @map("ip_address") @db.VarChar(45)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, family])
  @@map("refresh_tokens")
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("auth_token_purpose")
}

// Single-use tokens for password reset and email verification. Only a SHA-256 hash of the
// token is stored; consuming it sets usedAt, so a leaked or replayed link fails the second time.
model AuthActionToken {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  purpose         AuthTokenPurpose
  tokenHash       String           @unique @map("token_hash") @db.VarChar(128)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz()
  usedAt          DateTime?        @map("used_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_action_tokens")
}

model AuditLog {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  userId          String?          @map("user_id") @db.Uuid
  action          String           @db.VarChar(100) // e.g. "STUDENT_CREATED"
  entityName      String           @map("entity_name") @db.VarChar(100)
  entityId        String           @map("entity_id") @db.Uuid
  beforeState     Json?            @map("before_state")
  afterState      Json?            @map("after_state")
  ipAddress       String?          @map("ip_address") @db.VarChar(45)
  userAgent       String?          @map("user_agent") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  @@index([coachingId, entityName, entityId])
  @@index([coachingId, createdAt])
  @@map("audit_logs")
}

// ==========================================
// 3. People: Students, Parents, Teachers
// ==========================================

model Student {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  rollNumber      String?          @map("roll_number") @db.VarChar(50)
  firstName       String           @map("first_name") @db.VarChar(100)
  lastName        String           @map("last_name") @db.VarChar(100)
  gender          String?          @db.VarChar(20)
  dob             DateTime?        @db.Date
  phone           String?          @db.VarChar(30)
  email           String?          @db.VarChar(255)
  address         String?          @db.Text
  joiningDate     DateTime         @default(now()) @map("joining_date") @db.Date
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  coaching        Coaching         @relation(fields: [coachingId], references: [id], onDelete: Restrict)
  studentParents  StudentParent[]
  batchStudents   BatchStudent[]
  attendanceRecords AttendanceRecord[]
  testResults     TestResult[]
  feePlans        FeePlan[]
  timelineEntries StudentTimeline[]
  riskScore       RiskScore?

  @@index([coachingId, rollNumber])
  @@index([coachingId, phone])
  @@index([coachingId, createdAt])
  @@map("students")
}

model Parent {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  name            String           @db.VarChar(255)
  phone           String           @db.VarChar(30)
  email           String?          @db.VarChar(255)
  relation        String           @default("FATHER") @db.VarChar(50)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  coaching        Coaching         @relation(fields: [coachingId], references: [id], onDelete: Restrict)
  studentParents  StudentParent[]

  @@unique([coachingId, phone])
  @@index([coachingId, phone])
  @@map("parents")
}

model StudentParent {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  parentId        String           @map("parent_id") @db.Uuid
  isPrimary       Boolean          @default(true) @map("is_primary")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent          Parent           @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([coachingId, studentId])
  @@index([coachingId, parentId])
  @@map("student_parents")
}

model Teacher {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  userId          String           @unique @map("user_id") @db.Uuid
  name            String           @db.VarChar(255)
  phone           String           @db.VarChar(30)
  email           String           @db.VarChar(255)
  specialization  String?          @db.VarChar(255)
  monthlySalary   Decimal?         @map("monthly_salary") @db.Decimal(12, 2)
  joiningDate     DateTime         @default(now()) @map("joining_date") @db.Date
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  coaching        Coaching         @relation(fields: [coachingId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherBatches  TeacherBatch[]

  @@index([coachingId, phone])
  salaries        Salary[]
  @@map("teachers")
}

// ==========================================
// 4. Academics: Batches, Attendance, Tests, HW
// ==========================================

model Batch {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  name            String           @db.VarChar(100) // e.g. "Class 10 - Mathematics"
  subject         String?          @db.VarChar(100)
  academicYear    String           @map("academic_year") @db.VarChar(50)
  startTime       String?          @map("start_time") @db.VarChar(20)
  endTime         String?          @map("end_time") @db.VarChar(20)
  daysOfWeek      String[]         @default([]) @map("days_of_week")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  coaching        Coaching         @relation(fields: [coachingId], references: [id], onDelete: Restrict)
  batchStudents   BatchStudent[]
  teacherBatches  TeacherBatch[]
  attendanceSessions AttendanceSession[]
  tests           Test[]
  homeworks       Homework[]
  paperShares     PaperShare[]
  notices         Notice[]

  @@index([coachingId, isActive])
  @@map("batches")
}

model BatchStudent {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  batchId         String           @map("batch_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz()
  leftAt          DateTime?        @map("left_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([coachingId, batchId])
  @@index([coachingId, studentId])
  @@map("batch_students")
}

model TeacherBatch {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  teacherId       String           @map("teacher_id") @db.Uuid
  batchId         String           @map("batch_id") @db.Uuid
  isPrimary       Boolean          @default(true) @map("is_primary")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([teacherId, batchId])
  @@index([coachingId, teacherId])
  @@index([coachingId, batchId])
  @@map("teacher_batches")
}

model AttendanceSession {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  batchId         String           @map("batch_id") @db.Uuid
  sessionDate     DateTime         @map("session_date") @db.Date
  slot            String?          @db.VarChar(50)
  markedById      String?          @map("marked_by_id") @db.Uuid
  remarks         String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()

  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  records         AttendanceRecord[]

  @@unique([coachingId, batchId, sessionDate])
  @@index([coachingId, batchId, sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  sessionId       String           @map("session_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  status          AttendanceStatus @default(PRESENT)
  remarks         String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  session         AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([coachingId, studentId, status])
  @@map("attendance_records")
}

model Test {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  batchId         String           @map("batch_id") @db.Uuid
  title           String           @db.VarChar(255)
  subject         String           @db.VarChar(100)
  testDate        DateTime         @map("test_date") @db.Date
  totalMarks      Decimal          @map("total_marks") @db.Decimal(6, 2)
  passingMarks    Decimal?         @map("passing_marks") @db.Decimal(6, 2)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  results         TestResult[]

  @@index([coachingId, batchId, testDate])
  @@map("tests")
}

model TestResult {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  testId          String           @map("test_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  marksObtained   Decimal          @map("marks_obtained") @db.Decimal(6, 2)
  isAbsent        Boolean          @default(false) @map("is_absent")
  remarks         String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  test            Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([testId, studentId]) // Composite unique constraint for idempotent result uploads
  @@index([coachingId, studentId])
  @@map("test_results")
}

model Homework {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  batchId         String           @map("batch_id") @db.Uuid
  title           String           @db.VarChar(255)
  description     String           @db.Text
  dueDate         DateTime         @map("due_date") @db.Date
  attachmentUrl   String?          @map("attachment_url") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([coachingId, batchId, dueDate])
  @@map("homework")
}

// ==========================================
// 5. Finance: Fee Plans, Installments, Transactions
// ==========================================

model FeePlan {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  totalAmount     Decimal          @map("total_amount") @db.Decimal(12, 2)
  discountType    DiscountType?    @map("discount_type")
  discountValue   Decimal?         @map("discount_value") @db.Decimal(12, 2)
  finalAmount     Decimal          @map("final_amount") @db.Decimal(12, 2)
  academicYear    String           @map("academic_year") @db.VarChar(50)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  coaching        Coaching         @relation(fields: [coachingId], references: [id], onDelete: Restrict)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  installments    FeeInstallment[]

  @@index([coachingId, studentId])
  @@map("fee_plans")
}

model FeeInstallment {
  id              String               @id @default(uuid()) @db.Uuid
  coachingId      String               @map("coaching_id") @db.Uuid
  feePlanId       String               @map("fee_plan_id") @db.Uuid
  installmentNo   Int                  @map("installment_no")
  amount          Decimal              @db.Decimal(12, 2)
  paidAmount      Decimal              @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueDate         DateTime             @map("due_date") @db.Date
  status          FeeInstallmentStatus @default(PENDING)
  remarks         String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz()

  feePlan         FeePlan              @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  transactions    FeeTransaction[]

  @@index([coachingId, status, dueDate])
  @@map("fee_installments")
}

model FeeTransaction {
  id              String           @id @default(uuid()) @db.Uuid
  coachingId      String           @map("coaching_id") @db.Uuid
  installmentId   String           @map("installment_id") @db.Uuid
  amount          Decimal              @db.Decimal(12, 2)
  paymentMethod   PaymentMethod    @default(CASH) @map("payment_method")
  transactionRef  String?          @map("transaction_ref") @db.VarChar(100)
  receiptNumber   String           @map("receipt_number") @db.VarChar(100)
  paidAt          DateTime         @default(now()) @map("paid_at") @db.Timestamptz()
  remarks         String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  installment     FeeInstallment   @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@unique([coachingId, receiptNumber])
  // A gateway payment id (Razorpay pay_...) can be recorded once per coaching; webhook retries
  // and the paired payment.captured / payment_link.paid events therefore collapse to one row.
  @@unique([coachingId, transactionRef])
  @@index([coachingId, paidAt])
  @@map("fee_transactions")
}

model Salary {
